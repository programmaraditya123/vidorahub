MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=vidorahub
# Optional: existing account database when OAuth data is in a separate database.
MONGODB_USERS_DATABASE=test
# Optional: same secret as Express, only for /auth/me backend login tokens.
JWT_SECRET=
OAUTH_ISSUER=https://auth.vidorahub.com
MCP_RESOURCE=https://vidorahub.fastapicloud.dev/mcp
OAUTH_SCOPES=mcp:access
OAUTH_COOKIE_SECURE=true
# Generate a random value and share only with the MCP resource server.
INTROSPECTION_SECRET=replace-with-a-long-random-secret
